    checkbox selected
      accessibility label layerLabel(layer)
      when changed value
        toggleResearchLayer(layer, value)

    text layerLabel(layer)
      style body

component AgentStepRow(taskIndex Number, step AgentStep, stepIndex Number)
  card
    column
