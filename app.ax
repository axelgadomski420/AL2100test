    set errorText = "Opisz zgłoszenie i podaj powód."
    return
  set isBusy = true
  set errorText = ""
  try
    CloudflareApi.reportContent({ contentRef = ref, reason = reason, contentType = "user-report" })
    announceImportant("Zgłoszenie wysłane. Dziękujemy.")
  catch error
    set errorText = error.message
  finally
    set isBusy = false

