function regenerateImage(id Text)
  for asset in imageLibrary
    if asset.id is id
      set version = asset.versionNumber + 1
      update asset.versionNumber = version
      update asset.status = GenerationStatus.running
      appendVersion("image", asset.id, asset.prompt, asset.providerId, version)
  save imageLibrary
  runGeneration("image", id, prompt)
  announceLocal("Regeneracja zlecona. Nowa wersja dopisana do historii.")

function saveImageToGallery(id Text)
