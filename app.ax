function exportFile(name Text, content Json, format Text) returns Text
  return Platform.writeFile(name, content, format)

function exportFileEncrypted(name Text, content Json) returns Text
  return Platform.writeEncrypted(name, content)

function parseJson(text Text) returns Json
  return Platform.parseJson(text)

function joinText(items List<Text>, separator Text) returns Text
  return Platform.join(items, separator)

function joinNumbers(items List<Number>, separator Text) returns Text
  return Platform.joinNumbers(items, separator)

function splitText(text Text, separator Text) returns List<Text>
  return Platform.split(text, separator)

function debugLog() returns List<Text>
  return Platform.debugLog()

function clearDebugLog()
  Platform.clearDebugLog()

api Platform
  base "local://bridge"

  function pickFile(kinds List<Text>) returns Json
    native pickFile
    body { kinds }

  function record() returns File
    native recordAudio

  function transcribe(file File) returns Text
    native transcribe
    body { file }

  function speak(text Text, voice Text, rate Number, pitch Number)
    native speak
    body { text, voice, rate, pitch }

  function playMorse(buffer Text, wpm Number)
    native playMorse
    body { buffer, wpm }

  function vibrateMorse(buffer Text, wpm Number)
    native vibrateMorse
    body { buffer, wpm }

  function openUrl(url Text)
    native openUrl
    body { url }

  function copy(value Text)
    native copy
    body { value }

  function writeFile(name Text, content Json, format Text) returns Text
    native writeFile
    body { name, content, format }

  function writeEncrypted(name Text, content Json) returns Text
    native writeEncrypted
    body { name, content }

  function parseJson(text Text) returns Json
    native parseJson
    body { text }

  function join(items List<Text>, separator Text) returns Text
    native join
    body { items, separator }

  function joinNumbers(items List<Number>, separator Text) returns Text
    native joinNumbers
    body { items, separator }

  function split(value Text, separator Text) returns List<Text>
    native split
    body { value, separator }

  function debugLog() returns List<Text>
    native debugLog

  function clearDebugLog()
    native clearDebugLog

  function randomToken(length Number) returns Text
    native randomToken
    body { length }

function timestampMs() returns Number
  return systemNow().millis

function randomToken(length Number) returns Text
  return Platform.randomToken(length)

test "Maska sekretu nie pokazuje pełnego klucza"
  given text "sk-abcdef1234567890"
  when maskSecret(text)
  then result is "sk-a••••7890"

test "Ocena pewności źródła dla pustej listy wynosi zero"
  given value sourceConfidenceAverage([])
  when round(value * 100)
  then result is 0

test "Przełączanie warstwy badań dodaje i usuwa warstwę"
  given value toggleLayerSelection([1, 2], 3)
  when length(value)
  then result is 3

test "Etykieta pewności rozróżnia fakt od spekulacji"
  given value certaintyLabel(Certainty.speculation)
  when value
  then result is "Spekulacja"

test "Szacowany koszt rośnie liniowo z liczbą tokenów"
  given value estimateCost(providerSample(), 2000, 1000)
  when value
  then result is 0.09

ui test "Dodanie wiadomości do czatu"
  open Chat
  fill draft "Test wiadomości"
  tap "Wyślij"
  expect activeConversationMessages has 2 items

ui test "Utworzenie zadania agenta"
  open Agents
  fill goal "Porównaj trzy źródła o otwartych danych"
  tap "Utwórz plan i uruchom"
  expect agentHistory has 1 item

ui test "Zapis ustawienia motywu"
  open Settings
  tap "Motyw"
  expect settings.themeMode is not ""

accessibility test "Ekran czatu"
  open Chat
  expect all fields have labels
  expect all images have alt
  expect all icon buttons have accessibility label
  expect contrast passes AA
  expect screen reader announces title

accessibility test "Ekran ustawień"
  open Settings
  expect all fields have labels
  expect contrast passes AA
  expect text scale up to 200 percent is supported

accessibility test "Ekran dostępności"
  open Accessibility
  expect every gesture has a button alternative
  expect morse controls have vibration alternative
  expect no function depends on color alone



