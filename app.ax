function runQuickGenerate(kind Text, text Text)
  if kind is "image"
    set prompt = text
    generateImage()
  else if kind is "video"
    set prompt = text
    generateVideo()
  else if kind is "music"
    set prompt = text
    generateTrack()
  else
    runGeneration("text", newId(), text)

