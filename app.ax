function generateTrack()
  if length(prompt) < 3
    set errorText = "Opis musi mieć od 3 do 1200 znaków."
    return
  if sourceKind is "lyrics"
    if length(lyrics) < 10
      set errorText = "Tekst piosenki musi mieć od 10 do 4000 znaków."
      return
  set isBusy = true
  set created = Track(id = newId(), title = substring(prompt, 0, 40), prompt = prompt, lyrics = lyrics,
    genre = genre, mood = mood, instruments = instrumentsText, tempo = tempo,
    durationSeconds = durationSeconds, hasVocals = hasVocals, vocalLanguage = vocalLanguage,
    url = "", waveformJson = "[]", providerId = activeProviderId,
    model = modelForProvider(activeProviderId), status = GenerationStatus.running,
    isInstrumental = hasVocals is false, isAiGenerated = true, versionNumber = 1, createdAt = now())
  add created to trackLibrary
  save trackLibrary
  appendVersion("track", created.id, prompt, created.providerId, 1)
  set outputId = created.id
  runGeneration("music", created.id, prompt)
  set isBusy = false

