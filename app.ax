app "AL2100test"
version "1.0.0"
language pl
supports ios android web
orientation automatic
offline first
entry Home

theme default
  follows system

  color primary #7C3AED
  color accent #06B6D4
  color danger #DC2626
  color success #16A34A
  color warning #D97706

  color background light #FAFAFA
  color background dark #09090B
  color surface light #FFFFFF
  color surface dark #18181B
  color text light #09090B
  color text dark #FAFAFA
  color muted light #52525B
  color muted dark #A1A1AA
  color border light #E4E4E7
  color border dark #27272A

  radius small 10
  radius medium 16
  radius large 24
  radius full 999

  font body "Inter"
  font mono "JetBrains Mono"

  shadow soft 0 1 3 #00000012
  shadow medium 0 4 16 #00000018

style title
  font size 30
  weight bold
  line height 1.15
  letter spacing -0.4

style heading
  font size 20
  weight semibold

style subheading
  font size 17
  weight semibold

style body
  font size 16
  weight regular
  line height 1.5

style caption
  font size 13
  weight regular
  color theme.muted

style buttonPrimary
  background theme.primary
  color white
  radius medium
  padding 16 22

style buttonSecondary
  background theme.surface
  color theme.text
  radius medium
  padding 16 22

style buttonDanger
  background theme.danger
  color white
  radius medium
  padding 16 22

style buttonGhost
  background transparent
  color theme.primary
  radius medium
  padding 12 16

style card
  background theme.surface
  radius large
  padding 20

style pill
  background theme.surface
  radius full
  padding 8 14

style fieldBase
  background theme.surface
  radius medium
  padding 14 16
  border 1 theme.border

style badgeAi
  background theme.accent
  color white
  radius full
  padding 4 10

style badgeWarning
  background theme.warning
  color white
  radius full
  padding 4 10

style badgeDanger
  background theme.danger
  color white
  radius full
  padding 4 10

enum MessageRole
  user
  assistant
  system

enum MessageStatus
  pending
  streaming
  done
  failed

enum ChatMode
  quick
  research
  creative
  code
  learning

enum MediaKind
  text
  image
  video
  audio
  file
  music

enum ProviderType
  llm
  image
  video
  music
  tts
  stt
  translate
  search

enum PrivacyLevel
  local
  cloud
  hybrid

enum ConnectionStatus
  unknown
  ok
  authError
  rateLimited
  offline

enum Certainty
  fact
  opinion
  speculation
  aiGenerated

enum GenerationStatus
  queued
  running
  done
  failed
  cancelled

enum OutboxStatus
  pending
  sending
  sent
  failed

enum AgentKind
  research
  code
  image
  video
  music
  translation
  accessibility
  factCheck
  summarizer
  publisher

enum AgentStepStatus
  planned
  running
  done
  failed
  skipped

enum AppealState
  none
  flagged
  approved
  rejected

data Attachment
  id Text
  kind MediaKind
  url Text
  mimeType Text
  fileName Text
  sizeBytes Number
  altText Text
  transcript Text?
  createdAt Date

data SourceRef
  id Text
  title Text
  url Text
  layer Number
  publishedAt Date?
  excerpt Text
  certainty Certainty
  confidence Number
  license Text
  provider Text

data ChatMessage
  id Text
  conversationId Text
  role MessageRole
  body Text
  translatedBody Text?
  language Text
  mode ChatMode
  providerId Text
  model Text
  status MessageStatus
  attachments List<Attachment>
  sources List<SourceRef>
  costEstimate Number
  tokensIn Number
  tokensOut Number
  isAiGenerated Boolean
  createdAt Date

data Conversation
  id Text
  title Text
  persona Text
  mode ChatMode
  providerId Text
  model Text
  pinned Boolean
  archived Boolean
  messageCount Number
  updatedAt Date

data ProviderConfig
  id Text
  name Text
  type ProviderType
  baseUrl Text
  apiKeyRef Text
  model Text
  enabled Boolean
  isDefault Boolean
  priority Number
  usageCount Number
  notes Text
  lastUsedAt Date?
  freeLimitText Text
  costPerThousand Number
  status ConnectionStatus
  privacy PrivacyLevel
  supportsStreaming Boolean
  isCustom Boolean

data ResearchJob
  id Text
  question Text
  layers List<Number>
  status GenerationStatus
  answer Text
  sources List<SourceRef>
  confidence Number
  providerId Text
  createdAt Date
  completedAt Date?

data AgentTask
  id Text
  goal Text
  kind AgentKind
  status GenerationStatus
  plan List<AgentStep>
  result Text
  approved Boolean
  createdAt Date

data AgentStep
  id Text
  index Number
  title Text
  detail Text
  status AgentStepStatus
  startedAt Date?
  finishedAt Date?
  logText Text

data ImageAsset
  id Text
  prompt Text
  style Text
  aspectRatio Text
  quality Text
  variants Number
  url Text
  altText Text
  providerId Text
  model Text
  status GenerationStatus
  parentId Text?
  versionNumber Number
  isAiGenerated Boolean
  createdAt Date

data VideoAsset
  id Text
  prompt Text
  sourceKind Text
  sourceRef Text?
  durationSeconds Number
  aspectRatio Text
  style Text
  cameraMove Text
  mood Text
  url Text
  posterUrl Text
  descriptionForBlind Text
  subtitlesText Text
  voiceoverText Text
  providerId Text
  model Text
  status GenerationStatus
  versionNumber Number
  isAiGenerated Boolean
  createdAt Date

data Track
  id Text
  title Text
  prompt Text
  lyrics Text
  genre Text
  mood Text
  instruments Text
  tempo Number
  durationSeconds Number
  hasVocals Boolean
  vocalLanguage Text
  url Text
  waveformJson Text
  providerId Text
  model Text
  status GenerationStatus
  isInstrumental Boolean
  isAiGenerated Boolean
  versionNumber Number
  createdAt Date

data Playlist
  id Text
  name Text
  trackIds List<Text>
  createdAt Date

data UserProfileBasic
  id Text
  displayName Text
  email Text
  avatarUrl Text?
  bio Text
  language Text
  persona Text
  createdAt Date

data AppSettings
  themeMode Text
  accentColor Text
  textScale Number
  highContrast Boolean
  reduceMotion Boolean
  largeTargets Boolean
  appLanguage Text
  translateLanguage Text
  autoTranslate Boolean
  showOriginalAndTranslation Boolean
  defaultLlmProviderId Text
  defaultImageProviderId Text
  defaultVideoProviderId Text
  defaultMusicProviderId Text
  defaultTtsProviderId Text
  defaultSttProviderId Text
  defaultSearchProviderId Text
  ttsVoice Text
  ttsRate Number
  ttsPitch Number
  imageQuality Text
  videoQuality Text
  musicQuality Text
  defaultImageAspect Text
  defaultVideoAspect Text
  defaultVideoSeconds Number
  defaultMusicSeconds Number
  autoSaveGenerations Boolean
  autoSaveChats Boolean
  autoPlayMusic Boolean
  notifications Boolean
  sounds Boolean
  vibrations Boolean
  offlineMode Boolean
  dataSaver Boolean
  privacyMode Boolean
  simplifiedMode Boolean
  debugMode Boolean
  morseWpm Number
  vibrationStrength Number

data ApiUsageEntry
  id Text
  providerId Text
  providerType ProviderType
  model Text
  units Number
  costEstimate Number
  privacy PrivacyLevel
  status ConnectionStatus
  errorText Text?
  createdAt Date

data ModerationReport
  id Text
  contentType Text
  contentRef Text
  reason Text
  reporterRef Text
  state AppealState
  reviewerNote Text
  createdAt Date

data AccessibilityPrefs
  liveCaptions Boolean
  autoTranscribe Boolean
  describeImages Boolean
  describeVideos Boolean
  screenReaderHints Boolean
  liveTranslation Boolean
  morseEnabled Boolean
  vibrationCues Boolean
  voiceControl Boolean
  switchControl Boolean
  largeTargets Boolean
  highContrast Boolean
  reduceMotion Boolean
  simplifiedMode Boolean
  textScale Number

data OutboxItem
  id Text
  idempotencyKey Text
  kind Text
  payloadJson Text
  attempts Number
  status OutboxStatus
  lastError Text?
  createdAt Date

data GenerationVersion
  id Text
  assetKind Text
  assetId Text
  versionNumber Number
  promptSnapshot Text
  providerId Text
  createdAt Date

data DeviceKey
  id Text
  label Text
  publicKeyText Text
  verified Boolean
  createdAt Date

data SessionState
  accessTokenRef Text
  refreshTokenRef Text
  deviceId Text
  expiresAt Date?
  verified Boolean

store conversations local
  list Conversation
  key "al2100.chats.v1"

store messages local
  list ChatMessage
  key "al2100.messages.v1"

store providers local
  list ProviderConfig
  key "al2100.providers.v1"

store providerKeys secure
  list DeviceKey
  key "al2100.providerkeys.v1"

store settings local
  single AppSettings
  key "al2100.settings.v1"

store accessibility local
  single AccessibilityPrefs
  key "al2100.a11y.v1"

store profile local
  single UserProfileBasic
  key "al2100.profile.v1"

store session secure
  single SessionState
  key "al2100.session.v1"

store usageLog local
  list ApiUsageEntry
  key "al2100.usage.v1"

store imageLibrary local encrypted
  list ImageAsset
  key "al2100.images.v1"

store videoLibrary local encrypted
  list VideoAsset
  key "al2100.videos.v1"

store trackLibrary local encrypted
  list Track
  key "al2100.tracks.v1"

store playlists local
  list Playlist
  key "al2100.playlists.v1"

store researchHistory synced
  list ResearchJob
  key "al2100.research.v1"

store agentHistory synced
  list AgentTask
  key "al2100.agents.v1"

store outbox queue encrypted
  list OutboxItem
  key "al2100.outbox.v1"

store versionLog local
  list GenerationVersion
  key "al2100.versions.v1"

store knowledgeBase synced
  list SourceRef
  key "al2100.kb.v1"

global state currentUser UserProfileBasic? = none
global state isLoggedIn Boolean = false
global state isOnline Boolean = true
global state activeConversationId Text = ""
global state activeProviderId Text = "puter"
global state lastProviderUsed Text = ""
global state lastCostEstimate Number = 0
global state lastProviderStatus Text = "unknown"
global state announcementText Text = ""
global state moderationQueueOpen Boolean = false
global state playerTrackId Text = ""
global state playerPlaying Boolean = false
global state playerQueueIds List<Text> = []
global state unreadNotifications Number = 0

permission camera
  purpose "Analiza zdjęć i filmów w czacie"
  required false

permission microphone
  purpose "Czat głosowy i transkrypcja"
  required false

permission photos
  purpose "Wysyłanie zdjęć do czatu"
  required false

permission notifications
  purpose "Powiadomienia o zakończonych zadaniach agenta"
  required false

permission vibration
  purpose "Kod Morse'a i sygnały dostępności"
  required false

api CloudflareApi
  base "https://al2100test-api.workers.dev"
  auth bearer
  timeout 20000
  retry 3

  function health() returns Json
    get "/health"

  function register(email Text, password Text, displayName Text) returns Json
    post "/auth/register"
    body { email, password, displayName }

  function login(email Text, password Text, deviceId Text) returns Json
    post "/auth/login"
    body { email, password, deviceId }

  function refresh(refreshToken Text, deviceId Text) returns Json
    post "/auth/refresh"
    body { refreshToken, deviceId }

  function logout() returns Json
    post "/auth/logout"

  function requestPasswordReset(email Text) returns Json
    post "/auth/reset/request"
    body { email }

  function confirmPasswordReset(token Text, newPassword Text) returns Json
    post "/auth/reset/confirm"
    body { token, newPassword }

  function verifyEmail(token Text) returns Json
    post "/auth/verify-email"
    body { token }

  function getProfile() returns Json
    get "/me"

  function updateProfile(displayName Text, bio Text, avatarUrl Text?, language Text, persona Text) returns Json
    patch "/me"
    body { displayName, bio, avatarUrl, language, persona }

  function registerDevice(deviceId Text, platform Text, publicKeyText Text) returns Json
    post "/devices"
    body { deviceId, platform, publicKeyText }

  function listSessions() returns Json
    get "/devices"

  function revokeSession(deviceId Text) returns Json
    delete "/devices/" + deviceId

  function createRecoveryCodes() returns Json
    post "/auth/recovery-codes"

  function redeemRecoveryCode(code Text) returns Json
    post "/auth/recovery-codes/redeem"
    body { code }

  function listConversations() returns Json
    get "/conversations"

  function upsertConversation(payload Json) returns Json
    put "/conversations"
    body payload

  function deleteConversationServer(conversationId Text) returns Json
    delete "/conversations/" + conversationId

  function upsertMessage(payload Json) returns Json
    put "/messages"
    body payload

  function createResearchJob(payload Json) returns Json
    post "/research/jobs"
    body payload

  function getResearchJob(jobId Text) returns Json
    get "/research/jobs/" + jobId

  function createAgentJob(payload Json) returns Json
    post "/agents/jobs"
    body payload

  function getAgentJob(jobId Text) returns Json
    get "/agents/jobs/" + jobId

  function logProviderUsage(payload Json) returns Json
    post "/usage"
    body payload

  function getUsageSummary() returns Json
    get "/usage/summary"

  function uploadMedia(file File, kind Text) returns Json
    post "/media"
    multipart file
    body { kind }

  function reportContent(payload Json) returns Json
    post "/moderation/reports"
    body payload

  function listMyReports() returns Json
    get "/moderation/reports/mine"

  function exportAccount() returns Json
    get "/privacy/export"

  function eraseAccount(confirm Text) returns Json
    post "/privacy/erase"
    body { confirm }

  function listNotifications() returns Json
    get "/notifications"

  function markNotificationRead(notificationId Text) returns Json
    post "/notifications/" + notificationId + "/read"

api PublicResearchApi
  base "https://api.example.org"
  timeout 15000
  retry 2

  function wikipediaSearch(query Text, language Text) returns Json
    get "/wikipedia/search"
    body { query, language }

  function wikidataEntity(entityId Text) returns Json
    get "/wikidata/entity"
    body { entityId }

  function openLibrarySearch(query Text) returns Json
    get "/openlibrary/search"
    body { query }

  function archiveSearch(query Text) returns Json
    get "/archive/search"
    body { query }

  function openAlexSearch(query Text) returns Json
    get "/openalex/works"
    body { query }

  function governmentDataSearch(query Text, country Text) returns Json
    get "/govdata/search"
    body { query, country }

  function freesoundSearch(query Text) returns Json
    get "/freesound/search"
    body { query }

  function openSourceRepoSearch(query Text) returns Json
    get "/repos/search"
    body { query }

function newId() returns Text
  return "id_" + timestampMs() + "_" + randomToken(12)

function now() returns Date
  return systemNow()

function clamp(value Number, low Number, high Number) returns Number
  if value < low
    return low
  if value > high
    return high
  return value

function approxTokens(text Text) returns Number
  if length(text) is 0
    return 0
  return round(length(text) / 4)

function estimateCost(provider ProviderConfig, tokensIn Number, tokensOut Number) returns Number
  set total = tokensIn + tokensOut
  set cost = (total / 1000) * provider.costPerThousand
  return round(cost * 1000000) / 1000000

function announceLocal(text Text)
  set announcementText = text
  if accessibility.screenReaderHints
    announce(text)

function announceImportant(text Text)
  set announcementText = text
  announceUrgent(text)

function hapticTick()
  if accessibility.vibrationCues
    vibrate accessibility.vibrationStrength

function maskSecret(secret Text) returns Text
  if length(secret) is 0
    return ""
  if length(secret) <= 8
    return "••••"
  return substring(secret, 0, 4) + "••••" + substring(secret, length(secret) - 4, length(secret))

function isAiText(body Text) returns Boolean
  return contains(body, "[AI-generated]")

function markAiGenerated(body Text) returns Text
  if isAiText(body)
    return body
  return "[AI-generated] " + body

function certaintyLabel(value Certainty) returns Text
  if value is Certainty.fact
    return "Fakt"
  if value is Certainty.opinion
    return "Opinia"
  if value is Certainty.speculation
    return "Spekulacja"
  return "Treść AI"

function certaintyColor(value Certainty) returns Text
  if value is Certainty.fact
    return theme.success
  if value is Certainty.opinion
    return theme.accent
  if value is Certainty.speculation
    return theme.warning
  return theme.primary

function statusLabel(value ConnectionStatus) returns Text
  if value is ConnectionStatus.ok
    return "Połączony"
  if value is ConnectionStatus.authError
    return "Błąd klucza API"
  if value is ConnectionStatus.rateLimited
    return "Przekroczony limit"
  if value is ConnectionStatus.offline
    return "Offline"
  return "Nie sprawdzono"

function providerTypeLabel(value ProviderType) returns Text
  if value is ProviderType.llm
    return "Model językowy"
  if value is ProviderType.image
    return "Obrazy"
  if value is ProviderType.video
    return "Wideo"
  if value is ProviderType.music
    return "Muzyka"
  if value is ProviderType.tts
    return "Mowa (TTS)"
  if value is ProviderType.stt
    return "Transkrypcja (STT)"
  if value is ProviderType.translate
    return "Tłumaczenie"
  return "Wyszukiwanie"

function privacyLabel(value PrivacyLevel) returns Text
  if value is PrivacyLevel.local
    return "Lokalnie na urządzeniu"
  if value is PrivacyLevel.cloud
    return "W chmurze providera"
  return "Hybrydowo"

function layerLabel(layer Number) returns Text
  if layer is 1
    return "Warstwa 1 — bezpośrednia odpowiedź AI"
  if layer is 2
    return "Warstwa 2 — publiczny internet"
  if layer is 3
    return "Warstwa 3 — Wikipedia, Wikidata, Open Library"
  if layer is 4
    return "Warstwa 4 — Internet Archive"
  if layer is 5
    return "Warstwa 5 — otwarte banki zdjęć"
  if layer is 6
    return "Warstwa 6 — otwarte biblioteki audio"
  if layer is 7
    return "Warstwa 7 — dokumentacja i open source"
  if layer is 8
    return "Warstwa 8 — publikacje naukowe (Open Access)"
  if layer is 9
    return "Warstwa 9 — dane publiczne i API rządowe"
  return "Warstwa 10 — własna baza wiedzy"

function sortedProviders() returns List<ProviderConfig>
  return providers
    where enabled is true
    order by priority ascending

function providerById(id Text) returns ProviderConfig?
  for candidate in providers
    if candidate.id is id
      return candidate
  return none

function defaultForType(kind ProviderType) returns ProviderConfig?
  set chosen = none
  for candidate in providers
    if candidate.type is kind
      if candidate.enabled
        if candidate.isDefault
          return candidate
        if chosen is none
          set chosen = candidate
  return chosen

function firstEnabledForType(kind ProviderType) returns ProviderConfig?
  set best = none
  for candidate in providers
    if candidate.type is kind
      if candidate.enabled
        if best is none
          set best = candidate
        else if candidate.priority < best.priority
          set best = candidate
  return best

function recordProviderUse(provider ProviderConfig, units Number, cost Number, status ConnectionStatus, errorText Text?)
  set usageCount = usageCount + 1
  set lastUsedAt = now()
  set status = status
  save providers

  add ApiUsageEntry(
    id = newId(),
    providerId = provider.id,
    providerType = provider.type,
    model = provider.model,
    units = units,
    costEstimate = cost,
    privacy = provider.privacy,
    status = status,
    errorText = errorText,
    createdAt = now()
  ) to usageLog

  if length(usageLog) > 500
    remove usageLog[0] from usageLog

  save usageLog

  set lastProviderUsed = provider.name
  set lastCostEstimate = cost
  set lastProviderStatus = statusLabel(status)

function usageDropped(count Number)
  remove usageLog[0] from usageLog

function providerWarning(provider ProviderConfig) returns Text?
  if provider.usageCount >= 80
    return "Zbliżasz się do darmowego limitu (" + provider.freeLimitText + ")."
  return none

function secretDropped()
  announceLocal("Klucz usunięty z pamięci urządzenia.")

function appendVersion(assetKind Text, assetId Text, promptSnapshot Text, providerId Text, versionNumber Number)
  add GenerationVersion(
    id = newId(),
    assetKind = assetKind,
    assetId = assetId,
    versionNumber = versionNumber,
    promptSnapshot = promptSnapshot,
    providerId = providerId,
    createdAt = now()
  ) to versionLog

  if length(versionLog) > 1000
    remove versionLog[0] from versionLog

  save versionLog

function spendReceipt(provider ProviderConfig, units Number, cost Number) returns Text
  return provider.name + " • " + units + " jedn. • ~" + cost + " USD • " + privacyLabel(provider.privacy)

function emptySources() returns List<SourceRef>
  return []

function sourceConfidenceAverage(sources List<SourceRef>) returns Number
  if length(sources) is 0
    return 0
  set sum = 0
  for source in sources
    set sum = sum + source.confidence
  return round((sum / length(sources)) * 100) / 100

function sourcesToMarkdown(question Text, answer Text, sources List<SourceRef>) returns Text
  set out = "# " + question + newline() + newline()
  set out = out + answer + newline() + newline()
  set out = out + "## Źródła" + newline() + newline()
  for source in sources
    set out = out + "- [" + source.title + "](" + source.url + ") — " + certaintyLabel(source.certainty) + ", pewność " + source.confidence + ", warstwa " + source.layer + newline()
  set out = out + newline() + "Treść wygenerowana przez AI. Sprawdź źródła przed użyciem." + newline()
  return out

function sourcesToJson(question Text, answer Text, sources List<SourceRef>) returns Json
  set payload = {
    question: question,
    answer: answer,
    aiGenerated: true,
    sourceCount: length(sources),
    sources: sources
  }
  return payload

function researchTitleFrom(question Text) returns Text
  if length(question) <= 48
    return question
  return substring(question, 0, 45) + "..."

function translatePack(text Text, language Text) returns Json
  set payload = {
    text: text,
    targetLanguage: language,
    autoTranslate: settings.autoTranslate,
    showOriginal: settings.showOriginalAndTranslation
  }
  return payload

function messagePlainText(message ChatMessage) returns Text
  if settings.showOriginalAndTranslation
    if message.translatedBody is not none
      return message.body + newline() + newline() + message.translatedBody
  return message.body

function sourceCountByLayer(sources List<SourceRef>, layer Number) returns Number
  set count = 0
  for source in sources
    if source.layer is layer
      set count = count + 1
  return count

function layerIsSelected(layers List<Number>, layer Number) returns Boolean
  for item in layers
    if item is layer
      return true
  return false

function toggleLayerSelection(layers List<Number>, layer Number) returns List<Number>
  set next = []
  set removed = false
  for item in layers
    if item is layer
      set removed = true
    else
      add item to next
  if removed
    return next
  add layer to next
  return next

function defaultLayerSelection() returns List<Number>
  return [1, 2, 3, 4, 7, 8, 9, 10]

function agentKindLabel(value AgentKind) returns Text
  if value is AgentKind.research
    return "Research Agent"
  if value is AgentKind.code
    return "Code Agent"
  if value is AgentKind.image
    return "Image Agent"
  if value is AgentKind.video
    return "Video Agent"
  if value is AgentKind.music
    return "Music Agent"
  if value is AgentKind.translation
    return "Translation Agent"
  if value is AgentKind.accessibility
    return "Accessibility Agent"
  if value is AgentKind.factCheck
    return "Fact Check Agent"
  if value is AgentKind.summarizer
    return "Summarizer Agent"
  return "Publisher Agent"

function agentStepStatusLabel(value AgentStepStatus) returns Text
  if value is AgentStepStatus.planned
    return "Zaplanowany"
  if value is AgentStepStatus.running
    return "W trakcie"
  if value is AgentStepStatus.done
    return "Gotowe"
  if value is AgentStepStatus.failed
    return "Błąd"
  return "Pominięty"

function agentProgress(task AgentTask) returns Number
  if length(task.plan) is 0
    return 0
  set doneCount = 0
  for step in task.plan
    if step.status is AgentStepStatus.done
      set doneCount = doneCount + 1
  return round((doneCount / length(task.plan)) * 100)

function agentPlanFor(kind AgentKind, goal Text) returns List<AgentStep>
  if kind is AgentKind.research
    return [
      AgentStep(id = newId(), index = 1, title = "Dekompozycja celu", detail = goal, status = planned, logText = "Cel zamieniony na pytania badawcze."),
      AgentStep(id = newId(), index = 2, title = "Wyszukiwanie wielowarstwowe", detail = "Warstwy publiczne i baza wiedzy użytkownika.", status = planned, logText = "Zapytania skierowane do wybranych warstw."),
      AgentStep(id = newId(), index = 3, title = "Analiza wyników", detail = "Ocena pewności i rozdzielenie faktu od opinii.", status = planned, logText = "Klasyfikacja treści względem pewności."),
      AgentStep(id = newId(), index = 4, title = "Weryfikacja źródeł", detail = "Sprawdzenie, czy każde twierdzenie ma źródło.", status = planned, logText = "Twierdzenia bez źródła zostały oznaczone."),
      AgentStep(id = newId(), index = 5, title = "Raport", detail = "Złożenie raportu z listą źródeł.", status = planned, logText = "Raport gotowy do zatwierdzenia przez człowieka.")
    ]

  if kind is AgentKind.factCheck
    return [
      AgentStep(id = newId(), index = 1, title = "Wyodrębnienie twierdzeń", detail = goal, status = planned, logText = "Zdania rozbite na pojedyncze twierdzenia."),
      AgentStep(id = newId(), index = 2, title = "Dopasowanie źródeł", detail = "Szukanie niezależnego potwierdzenia.", status = planned, logText = "Zebrano potwierdzenia i zaprzeczenia."),
      AgentStep(id = newId(), index = 3, title = "Werdykt", detail = "Ocena: potwierdzone, niepotwierdzone, sprzeczne.", status = planned, logText = "Werdykt wystawiony z poziomem pewności.")
    ]

  if kind is AgentKind.summarizer
    return [
      AgentStep(id = newId(), index = 1, title = "Pobranie materiału", detail = goal, status = planned, logText = "Materiał wejściowy znormalizowany."),
      AgentStep(id = newId(), index = 2, title = "Skrót", detail = "Streszczenie w punktach.", status = planned, logText = "Napisano streszczenie."),
      AgentStep(id = newId(), index = 3, title = "Kontrola wierności", detail = "Porównanie skrótu z materiałem.", status = planned, logText = "Sprawdzono, czy skrót nie dodaje faktów.")
    ]

  return [
    AgentStep(id = newId(), index = 1, title = "Plan", detail = goal, status = planned, logText = "Plan przygotowany."),
    AgentStep(id = newId(), index = 2, title = "Wykonanie", detail = agentKindLabel(kind), status = planned, logText = "Zadanie wykonane."),
    AgentStep(id = newId(), index = 3, title = "Weryfikacja źródła", detail = "Kontrola legalności i licencji.", status = planned, logText = "Sprawdzono licencje i prawa."),
    AgentStep(id = newId(), index = 4, title = "Zatwierdzenie", detail = "Wynik czeka na decyzję użytkownika.", status = planned, logText = "Czeka na zatwierdzenie.")
  ]

function markStep(taskIndex Number, stepIndex Number, nextStatus AgentStepStatus, logText Text)
  update agentHistory[taskIndex].plan[stepIndex].status = nextStatus
  update agentHistory[taskIndex].plan[stepIndex].logText = logText
  if nextStatus is AgentStepStatus.running
    update agentHistory[taskIndex].plan[stepIndex].startedAt = now()
  if nextStatus is AgentStepStatus.done
    update agentHistory[taskIndex].plan[stepIndex].finishedAt = now()
  save agentHistory

function reportMarker(text Text) returns Text
  return "[" + text + "]"

component AiBadge(text Text)
  row
    gap 6
    align center
    text "AI"
      style badgeAi
    text text
      style caption

component SourceRow(source SourceRef)
  card
    column
      gap 8

      row
        gap 8
        align center

        text source.title
          style subheading
          max lines 2

        text certaintyLabel(source.certainty)
          style badgeWarning

      text source.url
        style caption
        max lines 2

      text source.excerpt
        style body
        max lines 4

      row
        gap 12
        align center

        text layerLabel(source.layer)
          style caption

        text "Pewność: " + round(source.confidence * 100) + "%"
          style caption

        text "Licencja: " + source.license
          style caption

      row
        gap 12
        align center

        button "Otwórz źródło"
          style buttonGhost
          accessibility label "Otwórz źródło w przeglądarce"
          when tapped
            openUrl(source.url)

        button "Kopiuj źródło"
          style buttonGhost
          accessibility label "Kopiuj adres źródła"
          when tapped
            copyToClipboard(source.url)
            announceLocal("Adres źródła skopiowany.")

component ProviderRow(provider ProviderConfig)
  card
    column
      gap 10

      row
        gap 10
        align center
        justify spaceBetween

        column
          gap 4
          text provider.name
            style subheading
          text providerTypeLabel(provider.type) + " • " + privacyLabel(provider.privacy)
            style caption

        text statusLabel(provider.status)
          style caption

      if provider.isDefault
        text "Domyślny dla swojego typu"
          style badgeAi

      if provider.isCustom
        text "Provider użytkownika"
          style pill

      text "Model: " + provider.model
        style caption

      text "Priorytet: " + provider.priority + " • Użycia: " + provider.usageCount
        style caption

      text "Darmowy limit: " + provider.freeLimitText
        style caption

      text "Szacowany koszt: " + provider.costPerThousand + " USD / 1000 jedn."
        style caption
      if provider.lastUsedAt is not none
        text "Ostatnie użycie: " + provider.lastUsedAt
          style caption

      if provider.notes is not ""
        text provider.notes
          style caption
          max lines 3

      set warning = providerWarning(provider)
      if warning is not none
        text warning
          style badgeWarning

      row
        gap 8
        align center

        button "Sprawdź"
          style buttonGhost
          accessibility label "Sprawdź połączenie z providerem"
          when tapped
            checkProviderConnection(provider.id)

        button "Włącz / wyłącz"
          style buttonGhost
          accessibility label "Włącz lub wyłącz providera"
          when tapped
            toggleProviderEnabled(provider.id)

        button "Ustaw domyślny"
          style buttonGhost
          accessibility label "Ustaw providera jako domyślnego"
          when tapped
            setDefaultProvider(provider.id)

        button "Usuń klucz"
          style buttonGhost
          accessibility label "Usuń klucz API z tego urządzenia"
          when tapped
            confirmRemoveKey(provider.id)

component AttachmentChip(attachment Attachment)
  card
    column
      gap 6

      text attachment.fileName
        style caption

      if attachment.kind is MediaKind.image
        image attachment.url
          width 120
          height 120
          alt attachment.altText

      if attachment.kind is MediaKind.video
        videoPlayer attachment.url
          controls true
          subtitles true

      if attachment.kind is MediaKind.audio
        audioPlayer attachment.url

      if attachment.transcript is not none
        text attachment.transcript
          style caption
          max lines 5

component MessageBubble(message ChatMessage)
  card
    column
      gap 10

      row
        gap 8
        align center

        text message.role
          style caption

        text message.model
          style caption

        if message.isAiGenerated
          text "AI"
            style badgeAi

      text messagePlainText(message)
        style body

      if message.mode is ChatMode.research
        if length(message.sources) > 0
          text "Źródła (" + length(message.sources) + ")"
            style subheading

          list message.sources
            empty
              text "Brak źródeł dla tej odpowiedzi."
                style caption

            item source
              SourceRow(source)

      list message.attachments
        empty
          text ""
            style caption

        item attachment
          AttachmentChip(attachment)

      row
        gap 12
        align center

        text "Provider: " + message.providerId
          style caption

        text "Koszt ~" + message.costEstimate + " USD"
          style caption

        text "Tokeny: " + message.tokensIn + " → " + message.tokensOut
          style caption

        text message.status
          style caption

      if message.status is MessageStatus.failed
        row
          gap 12
          align center

          button "Ponów"
            style buttonGhost
            accessibility label "Ponów wysyłanie wiadomości"
            when tapped
              retryMessage(message.id)

      row
        gap 8
        align center

        button "Kopiuj"
          style buttonGhost
          accessibility label "Kopiuj treść odpowiedzi"
          when tapped
            copyToClipboard(message.body)
            announceLocal("Odpowiedź skopiowana.")

        button "Regeneruj"
          style buttonGhost
          accessibility label "Wygeneruj odpowiedź ponownie"
          when tapped
            regenerateMessage(message.id)

        button "Zapisz"
          style buttonGhost
          accessibility label "Zapisz odpowiedź w bazie wiedzy"
          when tapped
            saveMessageToKnowledge(message.id)

        button "Przetłumacz"
          style buttonGhost
          accessibility label "Przetłumacz odpowiedź"
          when tapped
            translateMessage(message.id)

component TrackRow(track Track)
  card
    column
      gap 8

      row
        gap 10
        align center
        justify spaceBetween

        column
          gap 4
          text track.title
            style subheading
          text track.genre + " • " + track.mood + " • " + track.tempo + " BPM"
            style caption

        text track.status
          style caption

      if track.isAiGenerated
        text "AI-generated"
          style badgeAi

      audioPlayer track.url

      row
        gap 8
        align center

        button "Odtwórz"
          style buttonGhost
          accessibility label "Odtwórz utwór"
          when tapped
            playTrack(track.id)

        button "Dodaj do kolejki"
          style buttonGhost
          accessibility label "Dodaj utwór do kolejki odtwarzania"
          when tapped
            enqueueTrack(track.id)

        button "Eksportuj MP3"
          style buttonGhost
          accessibility label "Eksportuj utwór do pliku MP3"
          when tapped
            exportTrack(track.id, "mp3")

        button "Eksportuj WAV"
          style buttonGhost
          accessibility label "Eksportuj utwór do pliku WAV"
          when tapped
            exportTrack(track.id, "wav")

        button "Wyślij do czatu"
          style buttonGhost
          accessibility label "Udostępnij utwór w czacie"
          when tapped
            shareTrackToChat(track.id)

        button "Do filmu"
          style buttonGhost
          accessibility label "Użyj utworu jako ścieżki dźwiękowej filmu"
          when tapped
            attachTrackToVideo(track.id)

        button "Usuń"
          style buttonGhost
          accessibility label "Usuń utwór z biblioteki"
          when tapped
            confirmDeleteTrack(track.id)

component VersionRow(version GenerationVersion)
  row
    gap 10
