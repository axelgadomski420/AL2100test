  announceLocal(layerLabel(layer) + ": " + selected + ".")

// ---------------------------------------------------------------------------
// Prymitywy platformowe używane wyżej. Każdy jest jawnym kontraktem bridge'a,
// więc żadna akcja w aplikacji nie zostaje bez obsługi.
// ---------------------------------------------------------------------------

function pickFile(kinds List<Text>) returns Json
  return Platform.pickFile(kinds)

function recordAndTranscribe() returns Text
  return Platform.transcribe(Platform.record())

function speakText(text Text)
  Platform.speak(text, settings.ttsVoice, settings.ttsRate, settings.ttsPitch)

function playToneSequence(buffer Text, wpm Number)
  Platform.playMorse(buffer, wpm)

function vibrateMorse(buffer Text, wpm Number)
  Platform.vibrateMorse(buffer, wpm)

function openUrl(url Text)
  Platform.openUrl(url)

function copyToClipboard(text Text)
